{
  "name": "roundup_app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.1",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~58.0.25",
    "expo-blur": "~58.0.6",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.9",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "firebase": "^12.18.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "concurrently": "^10.0.5",
    "firebase-tools": "^15.29.0",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:8081": "expo start --web --port 8081",
    "web:8082": "expo start --web --port 8082",
    "web:8083": "expo start --web --port 8083",
    "web:3-perfis": "concurrently -n aluno,professor,academia -c blue,magenta,green \"npm run web:8081\" \"npm run web:8082\" \"npm run web:8083\"",
    "test:rules": "firebase emulators:exec --project demo-roundup-app --only firestore \"jest tests/rules --runInBand\"",
    "test:functions": "npm --prefix functions run build && firebase emulators:exec --project demo-roundup-app --only functions,firestore,auth,storage \"jest tests/functions --runInBand\"",
    "test:unit": "jest src"
  },
  "private": true
}
