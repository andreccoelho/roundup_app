function _item(form, idx) { return form.getItems()[Number(idx)]; }

function _resposta(item, v) {
  const T = FormApp.ItemType;
  switch (item.getType()) {
    case T.MULTIPLE_CHOICE: return item.asMultipleChoiceItem().createResponse(v);
    case T.CHECKBOX: return item.asCheckboxItem().createResponse(v);
    case T.SCALE: return item.asScaleItem().createResponse(Number(v));
    case T.GRID: return item.asGridItem().createResponse(v.map(String));
    case T.PARAGRAPH_TEXT: return item.asParagraphTextItem().createResponse(String(v));
    case T.TEXT: return item.asTextItem().createResponse(String(v));
    default: throw new Error('Tipo nao suportado: ' + item.getType());
  }
}

function _checar(form) {
  const items = form.getItems();
  const erros = [];
  DADOS.forEach(r => Object.keys(r).forEach(k => {
    if (k === 'id' || r[k] === '' || r[k] == null) return;
    const it = items[Number(k)];
    if (!it) { erros.push(r.id + ' item ' + k + ' inexistente'); return; }
    const T = FormApp.ItemType, t = it.getType();
    if (t == T.MULTIPLE_CHOICE) {
      const ch = it.asMultipleChoiceItem().getChoices().map(c => c.getValue());
      if (ch.indexOf(r[k]) < 0) erros.push(r.id + ' item ' + k + ': ' + r[k]);
    } else if (t == T.CHECKBOX) {
      const ch = it.asCheckboxItem().getChoices().map(c => c.getValue());
      r[k].forEach(x => { if (ch.indexOf(x) < 0) erros.push(r.id + ' item ' + k + ': ' + x); });
    } else if (t == T.GRID) {
      if (it.asGridItem().getRows().length != r[k].length) erros.push(r.id + ' grade ' + k + ' tamanho');
    }
  }));
  return erros;
}

function validarRespostas() {
  const form = FormApp.getActiveForm();
  const erros = _checar(form);
  Logger.log('Respostas: ' + DADOS.length);
  Logger.log(erros.length ? 'ERROS:\n' + erros.join('\n') : 'OK, tudo confere com o forms');
}

function enviarRespostas() {
  const form = FormApp.getActiveForm();
  if (form.getResponses().some(r => r.getItemResponses().some(ir => String(ir.getResponse()).indexOf('sintetico-') === 0))) {
    Logger.log('Ja existem respostas sinteticas nesta copia. Nada enviado para evitar duplicar.'); return;
  }
  const erros = _checar(form);
  if (erros.length) { Logger.log('Abortado. Rode validarRespostas para ver os erros.'); return; }
  let n = 0;
  DADOS.forEach(r => {
    const fr = form.createResponse();
    Object.keys(r).forEach(k => {
      if (k === 'id' || r[k] === '' || r[k] == null) return;
      fr.withItemResponse(_resposta(_item(form, k), r[k]));
    });
    fr.submit(); n++;
  });
  Logger.log('Enviadas: ' + n);
}
